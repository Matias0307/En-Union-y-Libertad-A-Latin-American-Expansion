@FACTION_NAME_Y = 45
@FACTION_ICON_Y = 80
@FACTION_POWER_CATEGORY_Y = 200
@FACTION_BOP_INFLUENCE_Y = 260
@NACISTA_TEXT_X = 80
@COMMUNIST_TEXT_X = 240
@NACISTA_X = 190
@COMMUNIST_X = 350
@EXPLANATION_X = 52
guiTypes = {

	containerWindowType = {
		name = "chl_internal_split_ui_window"
		position = { x = 0 y = 35 }
		size = { width = 100% height= 350 }
		
		iconType = {
			name ="CHL_background_img"
			spriteType = "GFX_CHL_bg_gui_2"
			position = { x = 0 y = 0 }
			size = { width = 100% height 100% }  
		}
		
		#EXPLANATIONS
		instantTextBoxType = {
			name ="power_category_text"
			position = { x = @EXPLANATION_X y = @FACTION_POWER_CATEGORY_Y }
			font = "hoi_18mbs"
			text = "CHL_power_category_text"
			format = center
			maxwidth = 136
		}
		
		instantTextBoxType = {
			name ="weekly_balance_of_power_influence_text"
			position = { x = @EXPLANATION_X y = @FACTION_BOP_INFLUENCE_Y }
			font = "hoi_18mbs"
			text = "CHL_weekly_balance_of_power_influence_text"
			format = center
			maxwidth = 136
		}
		
		#NAME 
		instantTextBoxType = {
			name ="nacista_name_text"
			position = { x = @NACISTA_TEXT_X y = @FACTION_NAME_Y }
			font = "hoi_24header"
			text = "CHL_nacista_name_text"
			format = center
			maxwidth = 320
		}
		
		instantTextBoxType = {
			name ="communist_name_text"
			position = { x = @COMMUNIST_TEXT_X y = @FACTION_NAME_Y }
			font = "hoi_24header"
			text = "CHL_communists_name_text"
			format = center
			maxwidth = 320
		}

		#ICONS
		iconType = {
			name ="nacista_icon"
			spriteType = "GFX_CHL_nacista_gui_icon"
			position = { x = @NACISTA_X y = @FACTION_ICON_Y }
		}

		iconType = {
			name ="communist_icon"
			spriteType = "GFX_CHL_communist_gui_icon"
			position = { x = @COMMUNIST_X y = @FACTION_ICON_Y }
		}

		#POWER CATEGORY
		instantTextBoxType = {
			name ="nacista_power_category"
			position = { x = @NACISTA_X y = 205 }
			font = "hoi_18mbs"
			text = "CHL_nacista_power_category_text"
			format = center
			maxHeight = 24
			maxwidth = 110
		}
		
		instantTextBoxType = {
			name ="communist_power_category"
			position = { x = @COMMUNIST_X y = 205 }
			font = "hoi_18mbs"
			text = "CHL_communist_power_category_text"
			format = center
			maxHeight = 24
			maxwidth = 110
		}
		
		#BoP Influence
		instantTextBoxType = {
			name ="nacista_BoP_influence"
			position = { x = @NACISTA_X y = @FACTION_BOP_INFLUENCE_Y }
			font = "hoi_24header"
			text = "CHL_nacista_BoP_influence_text"
			format = center
			maxHeight = 24
			maxwidth = 110
		}
		
		instantTextBoxType = {
			name ="communist_BoP_influence"
			position = { x = @COMMUNIST_X y = @FACTION_BOP_INFLUENCE_Y }
			font = "hoi_24header"
			text = "CHL_communist_BoP_influence_text"
			format = center
			maxHeight = 24
			maxwidth = 110
		}

		#Tooltips
		instantTextBoxType = {
			name ="CHL_power_category_tooltip_text"
			position = { x = 170 y = 160 }
			format = center
			maxwidth = 350
			maxHeight = 135
			pdx_tooltip = CHL_POWER_CATEGORY_TOOLTIP
		}
		
		instantTextBoxType = {
			name ="CHL_BoP_influence_tooltip_text"
			position = { x = 200 y = @FACTION_BOP_INFLUENCE_Y }
			format = center
			maxwidth = 450
			maxHeight = 205
			pdx_tooltip = CHL_BOP_INFLUENCE_TOOLTIP
		}
	}
}